# Copy this file to .env and fill in a key for ONE provider:
#   cp .env.example .env
#
# The scripted llm-wiki pipeline (scripts/llm.py) is provider-agnostic — choose
# Anthropic (default) or OpenAI below. The DCI notebook (dci.ipynb) is
# Anthropic-only and always needs ANTHROPIC_API_KEY.

# ── Anthropic (default) ───────────────────────────────────────────────────────
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional override; defaults to claude-opus-5-5 for Anthropic:
# LLM_MODEL=claude-opus-5-5

# ── OpenAI (alternative, for the scripted skill) ──────────────────────────────
# First install the extra:  uv sync --extra openai
# Get a key: https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# LLM_MODEL=<an-openai-model-id>   # REQUIRED for openai (no default)